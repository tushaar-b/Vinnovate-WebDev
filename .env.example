# Application Environment
ENVIRONMENT=development
TEST_MODE=false
LOG_LEVEL=INFO

# Backend API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL Database
# Driver: psycopg (PostgreSQL 3) or psycopg2-binary
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/changedetection

# Redis & RQ
REDIS_URL=redis://localhost:6379/0

# Storage
DATA_DIR=data/screenshots

# Frontend
VITE_API_URL=http://localhost:8000

# Credential Encryption at Rest (Authenticated Fernet AES-128-CBC + HMAC-SHA256)
# Generate a new 32-byte urlsafe base64 key using:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LIMITATIONS & RECOVERY:
# - Back up this key securely. If lost, existing encrypted credentials CANNOT be recovered.
# - Key Rotation: decrypt existing channels before rotating ENCRYPTION_KEY, then re-encrypt.
# - Application startup will fail safely if ENCRYPTION_KEY is missing or invalid when encrypted data exists.
ENCRYPTION_KEY=

# Production Access Control (Railway Configuration)
# ADMIN_PASSWORD: Required in production. Used by the operator to log in from the Vercel frontend.
ADMIN_PASSWORD=

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Set this to your exact Vercel frontend domain in production, e.g.:
# ALLOWED_ORIGINS=https://my-change-detector.vercel.app
ALLOWED_ORIGINS=

# Optional: Dedicated programmatic API key (header X-API-Key or Bearer token)
API_KEY=

# Optional: Custom session token signing secret (auto-derived from ENCRYPTION_KEY if omitted)
AUTH_TOKEN_SECRET=
