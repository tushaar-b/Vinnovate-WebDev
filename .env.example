# Application Environment
ENVIRONMENT=development
TEST_MODE=false
LOG_LEVEL=INFO

# Backend API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL Database
# Driver: psycopg (PostgreSQL 3) or psycopg2-binary
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/changedetection

# Redis & RQ
REDIS_URL=redis://localhost:6379/0

# Storage
DATA_DIR=data/screenshots

# Frontend
VITE_API_URL=http://localhost:8000
